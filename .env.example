# Pick ONE way to reach Claude for the voice agent.

# 1) Amazon Bedrock (counts for the AWS Builder mini challenge)
#    Easiest: a Bedrock API key (Bedrock console > API keys)
# AWS_BEARER_TOKEN_BEDROCK=...
#    or IAM access keys:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# 2) Claude API
# ANTHROPIC_API_KEY=...

# Which one answers (src/agent.ts)
#   CARECUE_PROVIDER=auto       Bedrock first, the Claude API as failover (12 s timeout, 60 s circuit breaker after 3 failures)
#   CARECUE_PROVIDER=anthropic-first   the other direction: Claude API first, Bedrock as failover (the shipping shape if a Bedrock model passes
#                               the safety rule); CARECUE_MODEL is then the Bedrock failover model, CARECUE_ANTHROPIC_MODEL the primary
#   CARECUE_PROVIDER=bedrock    Bedrock only        CARECUE_PROVIDER=anthropic   Claude API only
#   (unset)                     unchanged default: the Claude API when ANTHROPIC_API_KEY exists, else Bedrock;
#                               setting CARECUE_MODEL without CARECUE_PROVIDER means auto
# CARECUE_MODEL=us.anthropic.claude-opus-4-6-v1     Bedrock inference-profile id (run scripts/probe-bedrock.mjs to see what your key can call)
# CARECUE_FALLBACK_MODEL=claude-opus-5-5            Claude API model used as failover (or as the only model)
# CARECUE_ANTHROPIC_MODEL=claude-opus-5-5           Claude API model in any role (the primary with anthropic-first)
# CARECUE_BEDROCK_ADDENDUM=0                        off switch for the Bedrock-only prompt addendum (A/B runs of the safety suite); on by default
# GET /api/model shows the provider that actually answered, the failover count and the last request id.

# Optional
# PORT=8787
# CARECUE_MCP_TOKEN=change-me            # require "Authorization: Bearer <token>" on /mcp
# CARECUE_ALERT_WEBHOOK=https://ntfy.sh/your-private-topic   # push caregiver alerts to a phone
