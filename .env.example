# CareCue configuration. Copy to .env (never commit .env). Every line below is commented out: no values are shipped.
# Variables marked SHIPPING are what the public demo runs. See README.md "Run it" and docs/aws-integration.md.

# ---------- Claude API: the SHIPPING primary voice-agent model ----------
# ANTHROPIC_API_KEY=
# CARECUE_ANTHROPIC_MODEL=claude-opus-5-5          # the Claude API model in any role (the primary with anthropic-first)
# CARECUE_FALLBACK_MODEL=claude-opus-5-5           # same, used when CARECUE_ANTHROPIC_MODEL is not set

# ---------- Amazon Bedrock: the SHIPPING automatic failover (Claude Opus 4.6 through bedrock-runtime InvokeModel) ----------
# Pick one credential: a Bedrock API key (Bedrock console > API keys) or IAM credentials.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# AWS_REGION=us-east-1
# CARECUE_MODEL=us.anthropic.claude-opus-4-6-v1    # Bedrock inference-profile id; run `npm run probe:bedrock` to see what your key can call
# CARECUE_BEDROCK_ADDENDUM=0                       # off switch for the Bedrock-only prompt addendum (A/B runs of the safety suite); on by default

# ---------- Which provider answers (src/agent.ts) ----------
# CARECUE_PROVIDER=anthropic-first   SHIPPING: Claude API first, Amazon Bedrock as automatic failover (12 s primary timeout,
#                                    60 s circuit breaker after 3 failures in a row)
# CARECUE_PROVIDER=auto              the other direction: Bedrock first, Claude API as failover
# CARECUE_PROVIDER=bedrock           Bedrock only            CARECUE_PROVIDER=anthropic   Claude API only
# (unset)                            the Claude API when ANTHROPIC_API_KEY exists, else Bedrock; setting CARECUE_MODEL alone means auto
# GET /api/model shows the provider that actually answered, the failover count and the last request id.

# ---------- Server ----------
# PORT=8787
# HOST=127.0.0.1                     keep it on loopback behind a TLS reverse proxy (see README "Deploy")
# CARECUE_TZ=America/Santiago        household time zone (TZ also works)
# CARECUE_DB=                        path of the SQLite file (default data/carecue.db)
# CARECUE_DATA_DIR=                  folder for the database and the data/PAUSE kill-switch file
# CARECUE_SECRET=                    HMAC secret of the internal voice-agent tokens (random on every start when unset)
# CARECUE_PUBLIC_URL=                public https base URL, used for the MCP server icon and as an allowed browser origin

# ---------- MCP endpoint ----------
# CARECUE_MCP_TOKEN=                 require "Authorization: Bearer <token>" on /mcp (wrong bearer -> 401)
# CARECUE_ALLOWED_ORIGINS=           extra browser origins allowed to call /mcp, comma separated (same-origin and CARECUE_PUBLIC_URL are always allowed)

# ---------- Public instance and spend guard (src/limits.ts) ----------
# CARECUE_PUBLIC=1                   SHIPPING on the public server: limits on every route that can reach a model, on household creation and on /mcp
# CARECUE_AGENT_PAUSED=1             stop all model traffic (or create a data/PAUSE file)
# CARECUE_LIMIT_IP_DAY=40  CARECUE_LIMIT_IP_BURST=8  CARECUE_LIMIT_BURST_WINDOW_MIN=5  CARECUE_LIMIT_GLOBAL_DAY=500  CARECUE_LIMIT_TOKEN_DAY=60
# CARECUE_LIMIT_CREATE_IP_HOUR=10  CARECUE_LIMIT_CREATE_GLOBAL_DAY=300  CARECUE_LIMIT_MCP_IP_MIN=120
# CARECUE_LIMIT_URGENT_IP_DAY=30  CARECUE_LIMIT_URGENT_GLOBAL_DAY=2000
# CARECUE_SANDBOX_TTL_S=7200  CARECUE_SANDBOX_IP_HOUR=8  CARECUE_SANDBOX_MAX=150  CARECUE_AUTORESET_MIN=30   (private demo households)

# ---------- Alexa skill ----------
# ALEXA_SKILL_ID=                    accept requests only from this skill id (signature and timestamp are always verified)

# ---------- Alerts ----------
# CARECUE_ALERT_WEBHOOK=             a URL that receives caregiver alerts (an ntfy.sh topic URL gets ntfy headers). Not set on the public demo.
# CARECUE_EMERGENCY_NUMBER=          overrides 131 (Chile) / 911 (elsewhere)
# CARECUE_CRISIS_LINE=               overrides *4141 (Chile) / 988 (elsewhere)

# ---------- Local development and tests only (CARECUE_CLOCK_CONTROL and CARECUE_EVAL refuse to start together with CARECUE_PUBLIC=1) ----------
# CARECUE_CLOCK_CONTROL=1            lets POST /api/clock and /api/reset move the shared demo clock (the recorder and the tests)
# CARECUE_EVAL=1                     safety-suite hooks on loopback (npm run safety starts its own server with it)
# ALEXA_SKIP_VERIFY=1                skip Alexa signature checks (tests/alexa.ts)
# CARECUE_FAKE_AGENT=1               answer chat with a fixed string and no model call (UI and limit tests)
# CARECUE_RECORDER_KEY=              lets the local video recorder bypass the demo limits (scripts/ensure-recorder-key.mjs)
